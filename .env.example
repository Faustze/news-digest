# Optional local PostgreSQL (uv sync --group db; docker compose up -d)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://newsdigest:<password>@localhost:5434/newsdigest
TEST_DATABASE_URL=postgresql+psycopg://newsdigest:<password>@localhost:5434/newsdigest_test
